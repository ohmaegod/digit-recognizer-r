      "source": [
        "t0 <- Sys.time()\n",
        "res <- train_cnn(x_tr, y_tr, seed = 1, x_val = x_val, y_val = yval)\n",
        "cat(\"Training time:\", format(round(Sys.time() - t0, 1)), \"\\n\")\n",
        "\n",
        "val_probs <- predict_probs(res$model, x_val)\n",
        "val_pred  <- max.col(val_probs) - 1\n",
        "cnn_val_acc <- mean(val_pred == yval)\n",
        "cat(sprintf(\"\\nValidation accuracy  hand-built network: %.4f   CNN: %.4f\\n\", scratch_val_acc, cnn_val_acc))"
      ]
    },
