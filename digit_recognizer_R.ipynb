        "pred <- max.col(test_probs) - 1\n",
        "submission <- data.frame(ImageId = seq_len(nrow(Xtest)), Label = pred)\n",
        "write.csv(submission, \"submission.csv\", row.names = FALSE)\n",
        "\n",
        "stopifnot(nrow(submission) == 28000, all(submission$Label %in% 0:9))\n",
        "head(submission)\n",
        "table(submission$Label)\n",
        "\n",
        "# A few test digits with their predicted labels, as a final visual check\n",
        "par(mfrow = c(2, 6), mar = c(0.5, 0.5, 2, 0.5))\n",
        "for (i in 1:12) show_digit(Xtest[i, ], paste(\"pred:\", pred[i]))"
      ]
