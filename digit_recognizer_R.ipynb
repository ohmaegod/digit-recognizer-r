        "show_img <- function(M, title = \"\") {\n",
        "  image(t(M)[, 28:1], col = gray.colors(256, start = 1, end = 0), axes = FALSE, main = title)\n",
        "}\n",
        "show_digit <- function(row, title = \"\") show_img(matrix(row, 28, 28, byrow = TRUE), title)\n",
        "\n",
        "par(mfrow = c(2, 6), mar = c(0.5, 0.5, 2, 0.5))\n",
