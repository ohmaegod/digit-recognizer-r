      "source": [
        "augment <- function(x, max_rot = 10, max_zoom = 0.10, max_shift = 0.15) {\n",
        "  n <- x$size(1)\n",
        "  u <- function() torch_rand(n, device = x$device) * 2 - 1      # uniform in [-1, 1]\n",
        "  ang  <- u() * max_rot * pi / 180\n",
        "  zoom <- 1 + u() * max_zoom\n",
        "  cos_a <- torch_cos(ang) / zoom\n",
        "  sin_a <- torch_sin(ang) / zoom\n",
        "  theta <- torch_stack(list(\n",
        "    torch_stack(list(cos_a, sin_a * -1, u() * max_shift), dim = 2),\n",
        "    torch_stack(list(sin_a, cos_a,      u() * max_shift), dim = 2)), dim = 2)   # n x 2 x 3\n",
        "  grid <- nnf_affine_grid(theta, x$size(), align_corners = FALSE)\n",
        "  nnf_grid_sample(x, grid, mode = \"bilinear\", padding_mode = \"zeros\", align_corners = FALSE)\n",
        "}\n",
        "\n",
        "# Show one digit and five random augmented versions of it\n",
        "demo <- augment(x_tr[rep(1, 5), .., drop = FALSE])$cpu()\n",
        "par(mfrow = c(1, 6), mar = c(0.5, 0.5, 2, 0.5))\n",
        "show_digit(Xtr[1, ], \"original\")\n",
        "for (i in 1:5) show_img(as_array(demo[i, 1, , ]), \"augmented\")"
      ]
    },
