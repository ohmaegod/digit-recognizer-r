          ]
        }
      ],
      "source": [
        "test_probs <- matrix(0, nrow(Xtest), 10)\n",
        "t0 <- Sys.time()\n",
        "for (k in 1:N_MODELS) {\n",
        "  cat(sprintf(\"Model %d of %d\\n\", k, N_MODELS))\n",
        "  fit <- train_cnn(x_all, y_all, seed = 100 + k)\n",
        "  test_probs <- test_probs + predict_probs(fit$model, x_te)\n",
        "  rm(fit); gc()\n",
        "  if (on_gpu) try(cuda_empty_cache(), silent = TRUE)\n",
        "}\n",
        "cat(\"Total training time:\", format(round(Sys.time() - t0, 1)), \"\\n\")"
      ]
    },
